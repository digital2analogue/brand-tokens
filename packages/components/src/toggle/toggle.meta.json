{
  "metaVersion": "1.0.0",
  "status": "beta",
  "name": "rr-toggle",
  "summary": "Form-associated toggle switch for binary on/off settings.",
  "package": "@digital2analogue2/parsimony-components",
  "props": [
    {
      "name": "checked",
      "type": "boolean",
      "default": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false
    },
    {
      "name": "value",
      "type": "string",
      "default": "on"
    },
    {
      "name": "name",
      "type": "string",
      "default": ""
    },
    {
      "name": "label",
      "type": "string",
      "default": ""
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "Label text (alternative to the label property)."
    }
  ],
  "events": [
    {
      "name": "change",
      "detail": "Fired (bubbles, composed) when the toggle state changes; read the new state from the element's checked property."
    }
  ],
  "cssParts": [
    {
      "name": "track",
      "description": "The pill-shaped track element."
    },
    {
      "name": "knob",
      "description": "The sliding knob element."
    },
    {
      "name": "label",
      "description": "The label text element."
    }
  ],
  "tokensUsed": [
    "--spacing-tight",
    "--radius-full",
    "--color-border-default",
    "--color-background-alt",
    "--color-background-action",
    "--color-background-disabled",
    "--color-border-disabled",
    "--motion-duration-instant",
    "--motion-easing-default",
    "--color-foreground-muted",
    "--motion-easing-move",
    "--color-foreground-on-action",
    "--color-foreground-disabled",
    "--color-border-focus",
    "--font-label-medium",
    "--color-foreground-alt"
  ],
  "anatomy": {
    "description": "A track with a sliding knob beside a label, with the real <input> transparently overlaying the track. The 36x20 track, the 12px knob, its travel distance, and the focus-ring outline are not tokens.",
    "parts": [
      {
        "name": "root",
        "element": ":host",
        "description": "Inline-flex row holding the track and its label.",
        "tokens": {
          "spacing": "--spacing-tight"
        },
        "parts": [
          {
            "name": "track",
            "element": ".track",
            "cssPart": "track",
            "description": "The pill-shaped track. The native input sits transparently on top of it.",
            "tokens": {
              "background": "--color-background-alt",
              "border": "--color-border-default",
              "radius": "--radius-full",
              "motion": ["--motion-duration-instant", "--motion-easing-default"]
            },
            "states": [
              {
                "when": "checked",
                "tokens": {
                  "background": "--color-background-action",
                  "border": "--color-background-action"
                }
              },
              {
                "when": "disabled",
                "tokens": {
                  "background": "--color-background-disabled",
                  "border": "--color-border-disabled"
                }
              },
              {
                "when": ":focus-visible",
                "description": "Keyboard focus ring on the track, driven by the hidden input's focus state.",
                "tokens": {
                  "focus": "--color-border-focus"
                }
              }
            ],
            "parts": [
              {
                "name": "knob",
                "element": ".knob",
                "cssPart": "knob",
                "description": "The circle that slides across the track.",
                "tokens": {
                  "background": "--color-foreground-muted",
                  "motion": [
                    "--motion-duration-instant",
                    "--motion-easing-move",
                    "--motion-easing-default"
                  ]
                },
                "states": [
                  {
                    "when": "checked",
                    "tokens": {
                      "background": "--color-foreground-on-action"
                    }
                  },
                  {
                    "when": "disabled",
                    "tokens": {
                      "background": "--color-foreground-disabled"
                    }
                  }
                ]
              }
            ]
          },
          {
            "name": "label",
            "element": "label",
            "cssPart": "label",
            "description": "The text label beside the track.",
            "tokens": {
              "foreground": "--color-foreground-alt",
              "font": "--font-label-medium"
            },
            "states": [
              {
                "when": "disabled",
                "tokens": {
                  "foreground": "--color-foreground-disabled"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "rules": [
    "Never use hex values — always var(--color-*)",
    "Never reference --primitive-* tokens in component code",
    "All text/background pairings must pass WCAG AA (4.5:1)"
  ],
  "examples": [
    {
      "title": "Default (off)",
      "html": "<rr-toggle name=\"notify\">Email notifications</rr-toggle>"
    },
    {
      "title": "Checked",
      "html": "<rr-toggle name=\"darkMode\" label=\"Dark mode\" checked></rr-toggle>"
    },
    {
      "title": "Disabled",
      "html": "<rr-toggle label=\"Dark mode\" disabled></rr-toggle>"
    }
  ],
  "accessibility": {
    "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/switch/",
    "role": "switch",
    "focusable": true,
    "keyboard": ["Space toggles the switch", "Enter toggles the switch"],
    "wcag": [
      "1.4.3 Contrast (Minimum)",
      "2.1.1 Keyboard",
      "2.4.7 Focus Visible",
      "4.1.2 Name, Role, Value"
    ],
    "rules": [
      "A visually hidden native checkbox with role=switch provides focus, keyboard, and label-click semantics; aria-checked reflects the state.",
      "Form-associated via ElementInternals (formAssociated = true); the value participates in native form submission when checked."
    ]
  },
