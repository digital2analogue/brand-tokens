  ],
  "examples": [
    {
      "title": "Primary",
      "html": "<rr-button>Save changes</rr-button>"
    },
    {
      "title": "Secondary",
      "html": "<rr-button variant=\"secondary\">Cancel</rr-button>"
    },
    {
      "title": "Danger",
      "html": "<rr-button variant=\"danger\">Delete</rr-button>"
    },
    {
      "title": "Small",
      "html": "<rr-button size=\"sm\">Tag</rr-button>"
    },
    {
      "title": "Large",
      "html": "<rr-button size=\"lg\">Get started</rr-button>"
    },
    {
      "title": "Loading",
      "html": "<rr-button loading>Saving...</rr-button>"
    },
    {
      "title": "Disabled",
      "html": "<rr-button disabled>Unavailable</rr-button>"
    },
    {
      "title": "Icon-only",
      "html": "<rr-button aria-label=\"Close\"><span slot=\"prefix\">X</span></rr-button>"
    }
  ],
  "accessibility": {
    "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/button/",
    "focusable": true,
    "keyboard": [
      "Enter activates the button",
      "Space activates the button",
      "Tab moves focus to/from the button"
