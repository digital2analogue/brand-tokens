    "--color-border-action",
    "--color-background-default",
    "--color-background-danger-alt",
    "--color-foreground-danger",
    "--color-background-disabled",
    "--color-foreground-disabled",
    "--color-border-disabled",
    "--color-border-focus",
    "--font-label-strong-small",
    "--font-label-strong-medium",
    "--font-label-strong-large",
    "--spacing-micro",
    "--spacing-tight",
    "--spacing-inline",
    "--spacing-element",
    "--radius-default",
    "--motion-duration-instant",
    "--motion-easing-default"
  ],
  "rules": [
    "Never use hex values. Always use var(--color-*)",
    "Never reference --primitive-* tokens in component code",
    "All text/background pairings must pass WCAG AA (4.5:1)",
    "Primary button: one per page maximum",
