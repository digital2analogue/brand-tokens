{
  "metaVersion": "1.0.0",
  "status": "stable",
  "name": "rr-button",
  "summary": "Button with primary/secondary/danger/ghost variants, three sizes, loading spinner, and full keyboard/form semantics.",
  "package": "@digital2analogue2/parsimony-components",
  "props": [
    {
      "name": "variant",
      "type": "'primary' | 'secondary' | 'danger' | 'ghost'",
      "default": "primary",
      "bindings": {
        "code": {
          "prop": "variant"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "Variant",
          "valueMap": {
            "primary": "primary",
            "secondary": "secondary",
            "ghost": "ghost",
            "danger": "danger"
          }
        }
      }
    },
    {
      "name": "size",
      "type": "'sm' | 'md' | 'lg'",
      "default": "md",
      "bindings": {
        "code": {
          "prop": "size"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "valueMap": {
            "sm": "sm",
            "md": "md",
            "lg": "lg"
          }
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "bindings": {
        "code": {
          "prop": "disabled"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "State",
          "valueMap": {
            "disabled": true
          }
        }
      }
    },
    {
      "name": "loading",
      "type": "boolean",
      "default": false,
      "bindings": {
        "code": {
          "prop": "loading"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "State",
          "valueMap": {
            "loading": true
          }
        }
      }
    },
    {
      "name": "type",
      "type": "string",
      "default": "button"
    },
    {
      "name": "aria-label",
      "type": "string",
      "default": null
    }
  ],
  "slots": [
    {
      "name": "(default)",
      "description": "Button label text."
    },
    {
      "name": "prefix",
      "description": "Icon or element before the label."
    },
    {
      "name": "suffix",
      "description": "Icon or element after the label."
    }
  ],
  "events": [
    {
      "name": "click",
      "detail": "Native click event. Suppressed when disabled or loading."
    }
  ],
  "cssParts": [
    {
      "name": "button",
      "description": "The inner <button> element."
    }
  ],
  "anatomy": {
    "description": "The host is a bare wrapper; every token lives on the inner <button> (the exported part) and its two children. Compound conditions (variant=secondary AND :hover) have no grammar in v1 — those hover rules are in button.ts but not transcribed here.",
    "parts": [
      {
        "name": "root",
        "element": ":host",
        "description": "Host wrapper. Layout only (display: inline-block) — carries no tokens.",
        "parts": [
          {
            "name": "button",
            "element": "button",
            "cssPart": "button",
            "description": "The native <button>: fill, label colour, outline, padding, and the label font.",
            "tokens": {
              "background": "--color-background-action",
              "foreground": "--color-foreground-on-action",
              "border": "--color-background-action",
              "spacing": ["--spacing-tight", "--spacing-element"],
              "font": "--font-label-strong-medium",
              "radius": "--radius-default",
              "motion": ["--motion-duration-instant", "--motion-easing-default"]
            },
            "states": [
              {
                "when": ":hover",
                "tokens": {
                  "background": "--color-background-action-hover",
                  "border": "--color-background-action-hover"
                }
              },
              {
                "when": ":active",
                "tokens": {
                  "background": "--color-background-action-active",
                  "border": "--color-background-action-active"
                }
              },
              {
                "when": "size=sm",
                "tokens": {
                  "spacing": ["--spacing-micro", "--spacing-tight"],
                  "font": "--font-label-strong-small"
                }
              },
              {
                "when": "size=lg",
                "tokens": {
                  "spacing": ["--spacing-inline", "--spacing-element"],
                  "font": "--font-label-strong-large"
                }
              },
              {
                "when": "variant=secondary",
                "description": "Outlined: no fill, action-coloured label and edge.",
                "tokens": {
                  "background": "transparent",
                  "foreground": "--color-foreground-action",
                  "border": "--color-border-action"
                }
              },
              {
                "when": "variant=danger",
                "tokens": {
                  "background": "--color-background-default",
                  "foreground": "--color-foreground-danger",
                  "border": "--color-foreground-danger"
                }
              },
              {
                "when": "variant=ghost",
                "description": "Text-only: no fill, no edge.",
                "tokens": {
                  "background": "transparent",
                  "foreground": "--color-foreground-action",
                  "border": "transparent"
                }
              },
              {
                "when": "disabled",
                "tokens": {
                  "background": "--color-background-disabled",
                  "foreground": "--color-foreground-disabled",
                  "border": "--color-border-disabled"
                }
              },
              {
                "when": ":focus-visible",
                "description": "Keyboard focus ring, drawn as a 2px box-shadow.",
                "tokens": {
                  "focus": "--color-border-focus"
                }
              },
              {
                "when": ["variant=secondary", ":hover"],
                "tokens": {
                  "background": "--color-background-alt"
                }
              },
              {
                "when": ["variant=ghost", ":hover"],
                "tokens": {
                  "background": "--color-background-alt"
                }
              },
              {
                "when": ["variant=danger", ":hover"],
                "tokens": {
                  "background": "--color-background-danger-alt"
                }
              }
            ],
            "parts": [
              {
                "name": "label",
                "element": ".label",
                "description": "Inline-flex row holding the prefix, default, and suffix slots.",
                "tokens": {
                  "spacing": "--spacing-tight"
                }
              },
              {
                "name": "spinner",
                "element": ".spinner",
                "description": "Loading ring, drawn from the button's own text colour so it tracks every variant.",
                "tokens": {
                  "border": "currentColor"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "rules": [
    "Never use hex values. Always use var(--color-*)",
    "Never reference --primitive-* tokens in component code",
    "All text/background pairings must pass WCAG AA (4.5:1)",
    "Primary button: one per page maximum",
    "Icon-only buttons must have aria-label"
  ],
  "examples": [
    {
      "title": "Primary",
      "html": "<rr-button>Save changes</rr-button>"
    },
    {
      "title": "Secondary",
      "html": "<rr-button variant=\"secondary\">Cancel</rr-button>"
    },
    {
      "title": "Danger",
      "html": "<rr-button variant=\"danger\">Delete</rr-button>"
    },
    {
      "title": "Small",
      "html": "<rr-button size=\"sm\">Tag</rr-button>"
    },
    {
      "title": "Large",
      "html": "<rr-button size=\"lg\">Get started</rr-button>"
    },
    {
      "title": "Loading",
      "html": "<rr-button loading>Saving...</rr-button>"
    },
    {
      "title": "Disabled",
      "html": "<rr-button disabled>Unavailable</rr-button>"
    },
    {
      "title": "Icon-only",
      "html": "<rr-button aria-label=\"Close\"><span slot=\"prefix\">X</span></rr-button>"
    }
  ],
  "accessibility": {
    "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/button/",
    "focusable": true,
    "keyboard": [
      "Enter activates the button",
      "Space activates the button",
      "Tab moves focus to/from the button"
    ],
    "wcag": [
      "1.4.3 Contrast (Minimum)",
      "2.1.1 Keyboard",
      "2.4.6 Headings and Labels",
      "4.1.2 Name, Role, Value"
    ],
    "rules": [
      "delegatesFocus ensures host element forwards focus to inner <button>.",
      "aria-busy='true' set during loading state to communicate to AT.",
      "Icon-only buttons require aria-label for accessible name.",
      "disabled attribute removes from tab order and prevents activation.",
      "Click events are suppressed when disabled or loading."
    ]
  },
  "figma": {
    "componentKey": "",
    "nodeId": "98:56",
    "codeConnectFile": "button.figma.ts",
