{
  "metaVersion": "1.0.0",
  "status": "stable",
  "name": "rr-button",
  "summary": "Button with primary/secondary/danger/ghost variants, three sizes, loading spinner, and full keyboard/form semantics.",
  "package": "@digital2analogue2/parsimony-components",
  "props": [
    {
      "name": "variant",
      "type": "string",
      "default": "primary",
      "bindings": {
        "code": {
          "prop": "variant"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "Variant",
          "valueMap": {
            "primary": "primary",
            "secondary": "secondary",
            "ghost": "ghost",
            "danger": "danger"
          }
        }
      }
    },
    {
      "name": "size",
      "type": "string",
      "default": "md",
      "bindings": {
        "code": {
          "prop": "size"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "Size",
          "valueMap": {
            "sm": "sm",
            "md": "md",
            "lg": "lg"
          }
        }
      }
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false,
      "bindings": {
        "code": {
          "prop": "disabled"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "State",
          "valueMap": {
            "disabled": true
          }
        }
      }
    },
    {
      "name": "loading",
      "type": "boolean",
      "default": false,
      "bindings": {
        "code": {
          "prop": "loading"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "State",
          "valueMap": {
            "loading": true
          }
        }
      }
    },
    {
      "name": "type",
      "type": "string",
      "default": "button"
    },
    {
      "name": "aria-label",
      "type": "string",
      "default": null
    }
  ],
  "slots": [
    {
      "name": "(default)",
      "description": "Button label text."
    },
    {
      "name": "prefix",
      "description": "Icon or element before the label."
    },
    {
      "name": "suffix",
      "description": "Icon or element after the label."
    }
  ],
  "events": [
    {
      "name": "click",
      "detail": "Native click event. Suppressed when disabled or loading."
    }
  ],
  "cssParts": [
    {
      "name": "button",
      "description": "The inner <button> element."
    }
  ],
  "tokensUsed": [
    "--color-background-action",
    "--color-background-action-hover",
    "--color-background-action-active",
    "--color-foreground-on-action",
