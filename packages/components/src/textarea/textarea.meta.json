{
  "metaVersion": "1.0.0",
  "status": "beta",
  "name": "rr-textarea",
  "summary": "Form-associated multi-line text area with label, helper text, and error state.",
  "package": "@digital2analogue2/parsimony-components",
  "props": [
    {
      "name": "name",
      "type": "string",
      "default": ""
    },
    {
      "name": "value",
      "type": "string",
      "default": ""
    },
    {
      "name": "placeholder",
      "type": "string",
      "default": ""
    },
    {
      "name": "label",
      "type": "string",
      "default": ""
    },
    {
      "name": "helperText",
      "type": "string",
      "default": ""
    },
    {
      "name": "errorText",
      "type": "string",
      "default": ""
    },
    {
      "name": "rows",
      "type": "number",
      "default": 3
    },
    {
      "name": "required",
      "type": "boolean",
      "default": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "default": false
    }
  ],
  "slots": [
    {
      "name": "label",
      "description": "Optional override for the label text."
    }
  ],
  "events": [
    {
      "name": "input",
      "detail": "Fired (bubbles, composed) as the value changes; mirrors the native input event."
    },
    {
      "name": "change",
      "detail": "Fired (bubbles, composed) when the value is committed; mirrors the native change event."
    }
  ],
  "cssParts": [
    {
      "name": "label",
      "description": "The label element."
    },
    {
      "name": "textarea",
      "description": "The inner textarea element."
    },
    {
      "name": "helper",
      "description": "The helper text container."
    },
    {
      "name": "error",
      "description": "The error message container."
    }
  ],
  "anatomy": {
    "description": "The same four-sibling shape as rr-input, on a <textarea>. The label/helper/error margins are hardcoded px, not spacing tokens — deliberately not transcribed.",
    "parts": [
      {
        "name": "root",
        "element": ":host",
        "description": "Host wrapper. Layout only (display: block) — carries no tokens.",
        "parts": [
          {
            "name": "label",
            "element": "label",
            "cssPart": "label",
            "description": "Field label above the textarea.",
            "tokens": {
              "foreground": "--color-foreground-alt",
              "font": "--font-label-medium"
            },
            "states": [
              {
                "when": "disabled",
                "tokens": {
                  "foreground": "--color-foreground-disabled"
                }
              }
            ],
            "parts": [
              {
                "name": "required-marker",
                "element": ".required",
                "description": "The asterisk appended to a required field's label (aria-hidden).",
                "tokens": {
                  "foreground": "--color-foreground-danger"
                }
              }
            ]
          },
          {
            "name": "textarea",
            "element": "textarea",
            "cssPart": "textarea",
            "description": "The native <textarea>: field surface, text colour, and outline.",
            "tokens": {
              "background": "--color-background-default",
              "foreground": "--color-foreground-default",
              "border": "--color-border-default",
              "spacing": ["--spacing-tight", "--spacing-element"],
              "font": "--font-body-large",
              "radius": "--radius-sm",
              "motion": ["--motion-duration-instant", "--motion-easing-default"]
            },
            "states": [
              {
                "when": ":hover",
                "tokens": {
                  "border": "--color-border-hover"
                }
              },
              {
                "when": ":focus",
                "tokens": {
                  "focus": "--color-border-focus"
                }
              },
              {
                "when": "data-invalid",
                "description": "Set internally while error-text is non-empty.",
                "tokens": {
                  "border": "--color-foreground-danger"
                }
              },
              {
                "when": "disabled",
                "tokens": {
                  "background": "--color-background-alt",
                  "foreground": "--color-foreground-disabled",
                  "border": "--color-border-disabled"
                }
              },
              {
                "when": ["data-invalid", ":focus"],
                "description": "Focus ring while invalid — the ring turns danger red.",
                "tokens": {
                  "focus": "--color-foreground-danger"
                }
              }
            ],
            "parts": [
              {
                "name": "placeholder",
                "element": "::placeholder",
                "description": "Placeholder text inside the field.",
                "tokens": {
                  "foreground": "--color-foreground-muted"
                }
              }
            ]
          },
          {
            "name": "helper",
            "element": ".helper",
            "cssPart": "helper",
            "description": "Helper text below the field. Replaced by the error part while invalid.",
            "tokens": {
              "foreground": "--color-foreground-muted",
              "font": "--font-label-small"
            }
          },
          {
            "name": "error",
            "element": ".error",
            "cssPart": "error",
            "description": "Error message below the field (role=alert).",
            "tokens": {
              "foreground": "--color-foreground-danger",
              "font": "--font-label-small"
            }
          }
        ]
      }
    ]
  },
  "rules": [
    "Never use hex values — always var(--color-*)",
    "Never reference --primitive-* tokens in component code",
    "All text/background pairings must pass WCAG AA (4.5:1)",
    "Setting error-text marks the field invalid via ElementInternals.setValidity and replaces the helper text."
  ],
  "examples": [
    {
      "title": "Default",
      "html": "<rr-textarea label=\"Notes\" placeholder=\"Type here…\"></rr-textarea>"
    },
    {
      "title": "With helper text",
      "html": "<rr-textarea label=\"Bio\" helper-text=\"Max 500 characters\" rows=\"6\"></rr-textarea>"
    },
    {
      "title": "Required",
      "html": "<rr-textarea label=\"Feedback\" required></rr-textarea>"
    },
    {
      "title": "Error state",
      "html": "<rr-textarea label=\"Notes\" error-text=\"This field is required\"></rr-textarea>"
    },
    {
      "title": "Disabled",
      "html": "<rr-textarea label=\"Notes\" disabled></rr-textarea>"
    }
  ],
  "accessibility": {
    "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/textbox/",
    "role": "textbox",
    "focusable": true,
    "keyboard": [
      "Standard textarea editing keys apply to the inner native textarea"
    ],
    "wcag": [
      "1.4.3 Contrast (Minimum)",
      "2.1.1 Keyboard",
      "2.4.7 Focus Visible",
      "3.3.1 Error Identification",
      "3.3.2 Labels or Instructions",
      "4.1.2 Name, Role, Value"
    ],
    "rules": [
      "Host uses delegatesFocus so focus forwards to the inner native textarea.",
      "Error state sets aria-invalid and aria-errormessage; helper/error are wired via aria-describedby. The error container has role=alert.",
      "Form-associated via ElementInternals (formAssociated = true); the value participates in native form submission."
    ]
  },
