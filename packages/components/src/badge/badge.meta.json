{
  "metaVersion": "1.0.0",
  "status": "stable",
  "name": "rr-badge",
  "summary": "Status badge and accent chip. 9 variants styled by semantic tokens; brand theming cascades via CSS custom properties.",
  "package": "@digital2analogue2/parsimony-components",
  "props": [
    {
      "name": "variant",
      "type": "'default' | 'success' | 'warning' | 'danger' | 'info' | 'accent-green' | 'accent-blue' | 'accent-violet' | 'accent-amber'",
      "default": "default",
      "bindings": {
        "code": {
          "prop": "variant"
        },
        "figma": {
          "kind": "VARIANT",
          "property": "Variant",
          "valueMap": {
            "default": "default",
            "success": "success",
            "warning": "warning",
            "danger": "danger",
            "info": "info",
            "accent-green": "accent-green",
            "accent-blue": "accent-blue",
            "accent-violet": "accent-violet",
            "accent-amber": "accent-amber"
          }
        }
      }
    }
  ],
  "slots": [
    {
      "name": "default",
      "description": "Badge label text."
    }
  ],
  "events": [],
  "cssParts": [],
  "anatomy": {
    "description": "A single part. Every variant restyles the same host — badge's whole palette lives in its state overlays.",
    "parts": [
      {
        "name": "root",
        "element": ":host",
        "description": "The badge itself: pill-shaped inline-flex container holding the label slot.",
        "tokens": {
          "background": "--color-background-alt",
          "foreground": "--color-foreground-alt",
          "border": "--color-border-alt",
          "spacing": ["--spacing-micro", "--spacing-inline"],
          "font": "--font-label-small",
          "radius": "--radius-full"
        },
        "states": [
          {
            "when": "variant=success",
            "tokens": {
              "background": "--color-background-success-alt",
              "foreground": "--color-foreground-success",
              "border": "--color-background-success-alt"
            }
          },
          {
            "when": "variant=warning",
            "tokens": {
              "background": "--color-background-warning-alt",
              "foreground": "--color-foreground-warning",
              "border": "--color-background-warning-alt"
            }
          },
          {
            "when": "variant=danger",
            "tokens": {
              "background": "--color-background-danger-alt",
              "foreground": "--color-foreground-danger",
              "border": "--color-background-danger-alt"
            }
          },
          {
            "when": "variant=info",
            "tokens": {
              "background": "--color-background-info-alt",
              "foreground": "--color-foreground-info",
              "border": "--color-background-info-alt"
            }
          },
          {
            "when": "variant=accent-green",
            "tokens": {
              "background": "--color-background-accent-green",
              "foreground": "--color-foreground-accent-green",
              "border": "--color-background-accent-green"
            }
          },
          {
            "when": "variant=accent-blue",
            "tokens": {
              "background": "--color-background-accent-blue",
              "foreground": "--color-foreground-accent-blue",
              "border": "--color-background-accent-blue"
            }
          },
          {
            "when": "variant=accent-violet",
            "tokens": {
              "background": "--color-background-accent-violet",
              "foreground": "--color-foreground-accent-violet",
              "border": "--color-background-accent-violet"
            }
          },
          {
            "when": "variant=accent-amber",
            "tokens": {
              "background": "--color-background-accent-amber",
              "foreground": "--color-foreground-accent-amber",
              "border": "--color-background-accent-amber"
            }
          }
        ]
      }
    ]
  },
  "rules": [
    "Never use hex values. Always use var(--color-*)",
    "Never reference --primitive-* tokens in component code",
    "All text/background pairings must pass WCAG AA (4.5:1)",
    "Variants use a subtle style: a tinted background with accent-colored text, not a solid fill. The variant foreground is the accent color itself (e.g. foreground-accent-green), not foreground-on-{variant}.",
    "To make a variant solid instead (bright fill + dark text), point the variant's styles in badge.ts at background-{variant} and foreground-on-{variant}."
  ],
  "examples": [
    {
      "title": "Default",
      "html": "<rr-badge>Label</rr-badge>"
    },
    {
      "title": "Success",
      "html": "<rr-badge variant=\"success\">Active</rr-badge>"
    },
    {
      "title": "Warning",
      "html": "<rr-badge variant=\"warning\">Pending</rr-badge>"
    },
    {
      "title": "Danger",
      "html": "<rr-badge variant=\"danger\">Error</rr-badge>"
    },
    {
      "title": "Info",
      "html": "<rr-badge variant=\"info\">In Review</rr-badge>"
    },
    {
      "title": "Accent chips",
      "html": "<rr-badge variant=\"accent-green\">Tag</rr-badge>\n<rr-badge variant=\"accent-blue\">Category</rr-badge>\n<rr-badge variant=\"accent-violet\">Feature</rr-badge>\n<rr-badge variant=\"accent-amber\">New</rr-badge>"
    },
    {
      "title": "Live region",
      "html": "<rr-badge variant=\"success\" role=\"status\">Connected</rr-badge>"
    }
  ],
  "accessibility": {
    "ariaPattern": "https://www.w3.org/WAI/ARIA/apg/patterns/badge/",
    "focusable": false,
    "keyboard": [],
    "wcag": ["1.4.3 Contrast (Minimum)", "1.4.11 Non-text Contrast"],
    "rules": [
      "Add role=\"status\" on the host element when badge content updates dynamically to create an ARIA live region.",
      "Decorative badges (accent-*) do not need role=\"status\"; they are static labels.",
      "Badge text alone must convey meaning; do not rely solely on color to distinguish variants."
    ]
  },
  "figma": {
    "componentKey": "",
    "nodeId": "96:21",
    "codeConnectFile": "badge.figma.ts"
  }
}
