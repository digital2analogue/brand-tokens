  "anatomy": {
    "description": "Same four-sibling shape as rr-input, plus the custom arrow that replaces the native appearance. The label/helper/error margins and the arrow's inset are hardcoded px, not spacing tokens — deliberately not transcribed.",
    "parts": [
      {
        "name": "root",
        "element": ":host",
        "description": "Host wrapper. Layout only (display: block) — carries no tokens.",
        "parts": [
          {
            "name": "label",
            "element": "label",
            "cssPart": "label",
            "description": "Field label above the select.",
            "tokens": {
              "foreground": "--color-foreground-alt",
              "font": "--font-label-medium"
            },
            "states": [
              {
                "when": "disabled",
                "tokens": {
                  "foreground": "--color-foreground-disabled"
                }
              }
            ],
            "parts": [
              {
                "name": "required-marker",
                "element": ".required",
                "description": "The asterisk appended to a required field's label (aria-hidden).",
                "tokens": {
                  "foreground": "--color-foreground-danger"
                }
              }
            ]
          },
          {
            "name": "select",
            "element": "select",
            "cssPart": "select",
            "description": "The native <select>: field surface, text colour, and outline.",
            "tokens": {
              "background": "--color-background-default",
              "foreground": "--color-foreground-default",
              "border": "--color-border-default",
              "spacing": ["--spacing-tight", "--spacing-element"],
              "font": "--font-body-large"
            },
            "states": [
              {
                "when": ":hover",
                "tokens": {
                  "border": "--color-border-hover"
                }
              },
              {
                "when": ":focus",
                "tokens": {
                  "border": "--color-border-focus"
                }
              },
              {
                "when": "data-invalid",
                "description": "Set internally while error-text is non-empty.",
                "tokens": {
                  "border": "--color-foreground-danger"
                }
              },
              {
                "when": "disabled",
                "tokens": {
                  "background": "--color-background-alt",
                  "foreground": "--color-foreground-disabled",
                  "border": "--color-border-disabled"
                }
              }
            ],
            "parts": [
              {
                "name": "arrow",
                "element": ".arrow",
                "description": "The chevron overlaying the select, replacing the native appearance.",
                "tokens": {
                  "foreground": "--color-foreground-alt"
                },
                "states": [
                  {
                    "when": "disabled",
                    "tokens": {
                      "foreground": "--color-foreground-disabled"
                    }
                  }
                ]
              }
            ]
          },
          {
            "name": "helper",
            "element": ".helper",
            "cssPart": "helper",
            "description": "Helper text below the field. Replaced by the error part while invalid.",
            "tokens": {
              "foreground": "--color-foreground-muted",
              "font": "--font-label-small"
            }
          },
          {
            "name": "error",
            "element": ".error",
            "cssPart": "error",
            "description": "Error message below the field (role=alert).",
            "tokens": {
              "foreground": "--color-foreground-danger",
              "font": "--font-label-small"
            }
          }
        ]
      }
    ]
  },
  "rules": [
    "Never use hex values — always var(--color-*)",
    "Never reference --primitive-* tokens in component code",
    "All text/background pairings must pass WCAG AA (4.5:1)",
